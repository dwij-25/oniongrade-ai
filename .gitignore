# Environment & Secrets (NEVER COMMIT API KEYS)
.env
.env.local
.env.*.local
*.local

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Large Media & Archives
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Temporary Workspaces & Scratch Files
temp_*
temp/
tmp/
scratch/
