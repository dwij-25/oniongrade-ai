update.cjs
update_landing.cjs

# Cloud & Hosting Metadata
.vercel/
.netlify/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

